---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetflixTitle from '../components/common/NetflixTitle';
import { LAST_PERSONA_KEY } from '../persona/personas';
---

<BaseLayout>
  {/* Returning visitors (a persona was used before) skip the intro. Inline
      and in <head> so it runs before first paint — no splash flash. */}
  <script is:inline slot="head" define:vars={{ key: LAST_PERSONA_KEY }}>
    try {
      if (localStorage.getItem(key)) location.replace('/browse');
    } catch (e) {
      /* storage disabled — show the splash */
    }
  </script>
  <NetflixTitle client:load />
  {/* Crawlable entry links: the splash itself has no text content. */}
  <nav aria-label="Portfolio" class="visually-hidden">
    <a href="/browse">Choose a profile</a>
    <a href="/profile/recruiter">Portfolio</a>
  </nav>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
