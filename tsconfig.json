{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "astro.config.ts", "vitest.config.ts"],
  "exclude": ["build", "netlify"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "images/*": ["./src/images/*"],
      "persona/*": ["./src/persona/*"],
      "sounds/*": ["./src/sounds/*"],
      "styles/*": ["./src/styles/*"]
    }
  }
}
